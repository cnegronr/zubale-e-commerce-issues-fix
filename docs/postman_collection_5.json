    {
      "name": "Create Order - Fail-Fast Invalid User ID (400 Bad Request)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "if (pm.response.code === 400) {",
              "    var jsonData = pm.response.json();",
              "    pm.test('Response contains Fail-Fast invalid user ID validation error', function () {",
              "        var isExpectedError = jsonData.message && (",
              "            jsonData.message.includes('not found') ||",
              "            jsonData.message.includes('must be greater than') ||",
              "            (Array.isArray(jsonData.message) && jsonData.message.some(function(m) { return m.includes('userId'); }))",
              "        );",
              "        pm.expect(isExpectedError).to.be.true;",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
