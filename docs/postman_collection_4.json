    {
      "name": "Process Product Batch - Fail-Fast Invalid IDs",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.test('Batch result contains failedProductIds with [0, -1] without DB queries', function () {",
              "        pm.expect(jsonData.success).to.be.true;",
              "        pm.expect(jsonData.failedProductIds).to.include(0);",
              "        pm.expect(jsonData.failedProductIds).to.include(-1);",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productIds\": [0, -1]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products/batch",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "batch"
          ]
        },
        "description": "Verifies Fail-Fast batch processing for product IDs <= 0, reporting failedProductIds without hitting DB."
      }
    },
